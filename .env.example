# Groq API Configuration for MyMentor
# Get your free, ultra-fast API key at https://console.groq.com/keys
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# Recommended Groq Models:
# - llama-3.3-70b-versatile (Recommended: highly intelligent, ultra-fast)
# - llama-3.1-8b-instant (Ultra-low latency)
# - mixtral-8x7b-32768 (High context window)
# - gemma2-9b-it (Google Gemma 2)
VITE_GROQ_MODEL=llama-3.3-70b-versatile
