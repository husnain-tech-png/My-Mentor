# Groq API Configuration for MyMentor
# Get your free, ultra-fast API key at https://console.groq.com/keys
# For server-side proxy (Render / Production):
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# For local development with Vite dev server (optional):
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here
VITE_GROQ_MODEL=openai/gpt-oss-120b

# Verified Groq Models:
# - openai/gpt-oss-120b (Recommended Flagship: deep reasoning, multi-step planning)
# - openai/gpt-oss-20b (Instant: ultra-fast responses)
# - qwen/qwen3.8-27b (High capability instruction-following)
# - allam-2-7b (Specialized bilingual model for Arabic & Islamic ethics)

# Security & Access Control Configuration
# Optional: Fixed proxy session token. If omitted, a cryptographically secure 32-byte token is auto-generated on each boot.
# APP_API_TOKEN=your_secure_random_hex_token_here

# Optional: Comma-separated list of allowed CORS origins in production (e.g., https://mymentor.onrender.com)
# If omitted, strictly same-origin browser requests are permitted.
# ALLOWED_ORIGINS=https://mymentor.onrender.com

# Supabase Cloud Database & Auth Configuration
# Get your free project at https://supabase.com
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
